(check and cleanup older versions (only same OS version, when template is done and tested this directory can removed)
mkdir -p /root/images && cd /root/images && wget https://cloud-images.ubuntu.com/releases/releases/stonking/release/ubuntu-26.10-server-cloudimg-amd64.img

